# --- HTTP ---
PORT=3000
# When set, every request except / and /health needs `X-API-Key: <key>` or `Authorization: Bearer <key>` (min 8 chars)
API_KEY=
# Max JSON body / image upload size in MB
BODY_LIMIT_MB=10
SWAGGER_ENABLED=true
SWAGGER_PATH=swagger
# `*` or origins separated by `|`, empty = CORS off
CORS_ORIGIN=

# --- Printer (node-thermal-printer) ---
# epson | star | tanca | daruma | brother | custom
PRINTER_TYPE=epson
# USB device (/dev/usb/lp0), network printer (tcp://192.168.1.50:9100) or any writable file
PRINTER_INTERFACE=/dev/usb/lp0
# Characters per line: 48 for 80mm paper (TM-T20II), 32-35 for 58mm
PRINTER_WIDTH=48
# Code page, e.g. PC437_USA, PC858_EURO, PC850_MULTILINGUAL, WPC1252 (full list in README)
PRINTER_CHARACTER_SET=PC858_EURO
# Strip accents (é -> e) instead of switching code pages
PRINTER_REMOVE_SPECIAL_CHARACTERS=false
# Character used by the `line` command
PRINTER_LINE_CHARACTER=-
# Line wrapping: WORD | CHARACTER | NONE
PRINTER_BREAK_LINE=WORD
# Network connect timeout in ms (tcp:// interfaces)
PRINTER_TIMEOUT=3000
# Cut after every job unless the request sets "cut"
PRINTER_CUT_AFTER_JOB=true
